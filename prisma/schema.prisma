// Esquema recuperado por introspección de la base `fitback` (el backend
// anterior, cuya carpeta se borró). Los `@default(uuid())`, `@updatedAt` y los
// nombres de relación se reescribieron a mano: son atributos que solo viven en
// Prisma y la introspección no puede recuperarlos desde el SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  trainer
  client
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(client)
  createdAt DateTime @default(now())

  /// Baja lógica: borrar de verdad se lleva puestas sus sesiones y sus
  /// asignaciones por la cascada de FKs. Se marca, se filtra en la cartera y
  /// bloquea el login.
  deletedAt DateTime?

  /// La contraseña la eligió otro (alta por el entrenador, o generada por CLI).
  /// El front lo usa para empujar al usuario a cambiarla.
  mustChangePassword Boolean @default(false)

  /// Generación de los access tokens válidos. Cada JWT lleva la suya; subir
  /// este número invalida de golpe a todos los emitidos antes, aunque no hayan
  /// vencido, y es lo que le da efecto inmediato a cerrar todas las sesiones o
  /// a cambiar la contraseña sobre un JWT stateless.
  ///
  /// Es un contador y no una fecha de corte a propósito: el `iat` del JWT viene
  /// en SEGUNDOS, así que con una fecha un token emitido en el mismo segundo
  /// que el corte queda del lado equivocado —justo el caso del token nuevo que
  /// devuelve el cambio de contraseña—. Con un entero no hay ventana.
  ///
  /// Se compara en `JwtStrategy`, que ya relee al usuario en cada request, así
  /// que el chequeo no cuesta una query extra.
  tokenVersion Int @default(0)

  // Cartera: un cliente pertenece a un entrenador.
  trainerId String?
  trainer   User?   @relation("TrainerClients", fields: [trainerId], references: [id])
  clients   User[]  @relation("TrainerClients")

  ownedSplits          Split[]
  assignmentsAsClient  SplitAssignment[] @relation("AssignmentClient")
  assignmentsAsTrainer SplitAssignment[] @relation("AssignmentTrainer")
  sessions             WorkoutSession[]
  refreshTokens        RefreshToken[]
}

/// Sesión de larga duración de un dispositivo.
///
/// El access token es stateless y corto; este es el que se guarda y permite
/// pedir uno nuevo sin volver a tipear la contraseña. Al usarse se ROTA: el
/// viejo queda revocado apuntando al que lo reemplazó, así que si alguien
/// reusa uno ya gastado se detecta y se cierran todas las sesiones del usuario.
model RefreshToken {
  id String @id @default(uuid())

  /// SHA-256 en hex. El valor en claro lo tiene solo el cliente: si se filtra
  /// la base, estos hashes no sirven para entrar.
  tokenHash String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  /// El token que reemplazó a este al rotar. Que exista y además llegue un uso
  /// del viejo es la señal de reuso.
  replacedById String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Split {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Soft delete: borrar de verdad se lleva puesto el historial de series por
  /// la cascada de FKs. Se marca y se filtra en las lecturas.
  deletedAt DateTime?

  // Autor de la rutina (el entrenador que la armó).
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  microcycles Microcycle[]
  assignments SplitAssignment[]
}

// A quién se le asignó una rutina. Es lo que hace que un cliente "tenga"
// splits sin ser su autor.
model SplitAssignment {
  id         String   @id @default(uuid())
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())

  splitId String
  split   Split  @relation(fields: [splitId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation("AssignmentClient", fields: [clientId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   User   @relation("AssignmentTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([clientId, splitId])
}

model Microcycle {
  id    String @id @default(uuid())
  name  String
  /// `order` es único entre hermanos VIVOS, pero el índice no se ve acá: es
  /// parcial (`WHERE "deletedAt" IS NULL`) y Prisma no sabe expresarlo. Vive
  /// en la migración `20260907143000_unicidad_de_order`.
  order Int

  /// Soft delete: borrar de verdad se lleva puesto el historial de series por
  /// la cascada de FKs. Se marca y se filtra en las lecturas.
  deletedAt DateTime?

  splitId String
  split   Split  @relation(fields: [splitId], references: [id], onDelete: Cascade)

  days Day[]
}

model Day {
  id    String  @id @default(uuid())
  name  String
  /// `order` es único entre hermanos VIVOS, pero el índice no se ve acá: es
  /// parcial (`WHERE "deletedAt" IS NULL`) y Prisma no sabe expresarlo. Vive
  /// en la migración `20260907143000_unicidad_de_order`.
  order Int
  focus String?

  /// Soft delete: borrar de verdad se lleva puesto el historial de series por
  /// la cascada de FKs. Se marca y se filtra en las lecturas.
  deletedAt DateTime?

  microcycleId String
  microcycle   Microcycle @relation(fields: [microcycleId], references: [id], onDelete: Cascade)

  exercises DayExercise[]
  sessions  WorkoutSession[]
}

model DayExercise {
  id                String  @id @default(uuid())
  name              String
  /// `order` es único entre hermanos VIVOS, pero el índice no se ve acá: es
  /// parcial (`WHERE "deletedAt" IS NULL`) y Prisma no sabe expresarlo. Vive
  /// en la migración `20260907143000_unicidad_de_order`.
  order             Int
  targetSets        Int
  targetRestSeconds Int?
  notes             String?

  /// Soft delete: borrar de verdad se lleva puesto el historial de series por
  /// la cascada de FKs. Se marca y se filtra en las lecturas.
  deletedAt DateTime?

  // Objetivos como rango (las pantallas nuevas muestran "10 a 12", "1 a 0").
  targetRepsMin Int?
  targetRepsMax Int?
  targetRirMin  Int?
  targetRirMax  Int?
  toFailure     Boolean @default(false)

  // Agrupa ejercicios encadenados (superserie 04A + 04B).
  supersetGroup String?

  dayId String
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)

  setLogs SetLog[]
}

model WorkoutSession {
  id          String   @id @default(uuid())
  performedAt DateTime @default(now())
  notes       String?

  /// Sesión cerrada. Mientras sea null la sesión sigue abierta: el historial
  /// de progreso no la toma como semana registrada y el front sabe que lo que
  /// ve es parcial.
  completedAt DateTime?

  dayId String
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  setLogs SetLog[]
}

model SetLog {
  id         String  @id @default(uuid())
  setNumber  Int
  actualReps Int?
  actualRir  Int?
  weight     Float?
  completed  Boolean @default(false)
  skipped    Boolean @default(false)

  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  dayExerciseId String
  dayExercise   DayExercise @relation(fields: [dayExerciseId], references: [id], onDelete: Cascade)

  // Clave natural del upsert en lote (PUT /sessions/:id/set-logs).
  @@unique([sessionId, dayExerciseId, setNumber])
}
