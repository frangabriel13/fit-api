DATABASE_URL="postgresql://fitback:fitback@localhost:5433/fitback?schema=public"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
# Dura 7d porque el front todavía no usa el refresh token. Cuando lo use,
# bajarlo a "15m": es el punto de tener refresh.
JWT_EXPIRES_IN="7d"
# Días que dura la sesión de un dispositivo (el refresh token).
REFRESH_EXPIRES_DAYS=30
APP_TIMEZONE="America/Argentina/Buenos_Aires"
PORT=3003
CORS_ORIGIN="http://localhost:3002"

# --- Rate limit ---------------------------------------------------------
# Tope general por IP y por minuto. Holgado porque el uso normal del front son
# ráfagas: el upsert de series sale cada 800ms mientras se tipea.
THROTTLE_LIMIT=300
# Tope de /auth/login y /auth/refresh, por IP y por minuto. Mucho más bajo:
# son los únicos endpoints donde adivinar sirve de algo.
THROTTLE_AUTH_LIMIT=10

# --- Detrás de un proxy -------------------------------------------------
# Cantidad de proxies delante (nginx, Cloudflare, un PaaS). Vacío = no confiar
# en X-Forwarded-For. DEJARLO VACÍO si no hay proxy real: confiar en esa
# cabecera sin uno adelante deja que cualquiera se invente la IP y saltee el
# rate limit.
# TRUST_PROXY=1
